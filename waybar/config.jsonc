// ~/.config/waybar/config.jsonc
// Ported from dwmblocks. Same info, in the same order (media, weather,
// temp, mem, battery, date) — but temp/mem/battery/clock now use
// waybar's built-in modules instead of shell one-liners, since they're
// more robust (proper battery states, no manual parsing, etc).

{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["tray", "sway/workspaces", "sway/window", "sway/mode"],
    "modules-center": ["custom/media"],
    "modules-right": [
		"custom/network",
        "custom/bluetooth",
        "temperature",
        "memory",
        "battery",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false
    },

    "sway/window": {
        "format": "{title}",
        "max-length": 50,
        "tooltip": false
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    // --- custom scripts ---

    "custom/media": {
        "exec": "~/.config/waybar/scripts/now-playing.sh",
        "return-type": "json",
        "interval": 1,
        "signal": 11,
        "format": "{}",
        "max-length": 60,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true
    },

    // --- built-in modules (replace cpu_temp.sh, free -h, and BAT1 cat) ---

    "temperature": {
        // adjust thermal-zone if this isn't your CPU zone
        // (check `cat /sys/class/thermal/thermal_zone*/type`)
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": "   {temperatureC}°C ",
        "format-critical": "   {temperatureC}°C ",
        "tooltip": true
    },

    "memory": {
        "interval": 30,
        "format": "   {used:0.1f}G/{total:0.1f}G ",
        "tooltip-format": "RAM used: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)"
    },

    "battery": {
        "bat": "BAT1",
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "󰣇  {capacity}% ",
        "format-charging": "󰣇   {capacity}% ",
        "tooltip-format": "{timeTo}, {capacity}%"
    },

    "clock": {
        "interval": 5,
        "format": "󰃭  {:%b %d (%a) %H:%M}  ",
        "tooltip-format": "{:%Y-%m-%d}"
    },

	"tray": {
        "icon-size": 16,
        "spacing": 8
    },

	"custom/network": {
		"exec": "~/.config/waybar/scripts/network-status.sh",
		"return-type": "json",
		"interval": 5,
		"on-click": "~/.config/waybar/scripts/network-menu.sh",
		"tooltip": true
    },

    "custom/bluetooth": {
		"exec": "~/.config/waybar/scripts/bluetooth-status.sh",
		"return-type": "json",
		"interval": 5,
		"on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
		"tooltip": true
    },
}
